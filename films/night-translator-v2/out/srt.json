  "text": "《深夜翻译官》"
 },
 {
  "t0": 26.817,
  "t1": 31.05,
  "text": "老校：天亮之前——一个字也不许错。"
 },
 {
  "t0": 36.85,
  "t1": 39.75,
  "text": "Hold your horses!"
 },
 {
  "t0": 39.95,
  "t1": 42.75,
  "text": "抓住你的马！"
 },
 {
  "t0": 44.45,
  "t1": 46.25,
  "text": "别急！"
 },
 {
  "t0": 50.279,
  "t1": 53.036,
  "text": "I'm head over heels!"
 },
 {
  "t0": 53.236,
  "t1": 56.131,
  "text": "我头在脚跟上！"
 },
 {
  "t0": 59.717,
  "t1": 62.321,
  "text": "我神魂颠倒！"
 },
 {
  "t0": 66.295,
  "t1": 69.657,
  "text": "It's raining cats and dogs!"
 },
 {
  "t0": 72.164,
  "t1": 74.56,
  "text": "天上下猫下狗！"
 },
 {
  "t0": 74.86,
