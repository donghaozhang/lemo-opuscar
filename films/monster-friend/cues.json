[
 {
  "t0": 8,
  "t1": 11.4,
  "text": "豆豆搬到了新城市。"
 },
 {
  "t0": 20,
  "t1": 25.4,
  "text": "新的幼儿园里，豆豆一个字也说不出来。"
 },
 {
  "t0": 36,
  "t1": 41,
  "text": "晚上，豆豆画了一只紫色的大怪兽。"
 },
 {
  "t0": 50.2,
  "t1": 55.4,
  "text": "豆豆害怕，它就变小；豆豆勇敢，它就变大。"
 },
 {
  "t0": 57,
  "t1": 63,
  "text": "第二天，怪兽躲进了书包。只有豆豆能看见它。"
 },
 {
  "t0": 71.6,
  "t1": 76.8,
  "text": "怪兽吃掉了蜡笔，打了一个彩色的喷嚏。"
 },
 {
  "t0": 85,
  "t1": 90,
  "text": "妮妮的气球挂在树上了。"
 },
 {
  "t0": 93,
  "t1": 96,
  "text": "豆豆吸了一口气。"
 },
 {
  "t0": 98.6,
  "t1": 100.6,
  "text": "你好"
 },
 {
  "t0": 108.3,
  "t1": 113.3,
  "text": "妮妮用黄色的蜡笔，也画了一只怪兽。"
 },
 {
  "t0": 116,
  "t1": 122,
  "text": "两只怪兽一起玩，两个朋友一起笑。"
 },
 {
  "t0": 126,
  "t1": 131,
  "text": "晚上，怪兽回到了书里。"
 },
 {
  "t0": 134.6,
  "t1": 140,
  "text": "我的朋友"
 }
]